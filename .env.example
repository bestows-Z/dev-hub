POSTGRES_USER=devhub
POSTGRES_PASSWORD=change_me
POSTGRES_DB=devhub

REDIS_PASSWORD=change_me
REDIS_ADDR=127.0.0.1:6379
ELASTICSEARCH_URL=http://127.0.0.1:9200

MONGO_ROOT_USERNAME=devhub
MONGO_ROOT_PASSWORD=change_me
MONGO_ADDR=127.0.0.1:27017

RABBITMQ_USERNAME=devhub
RABBITMQ_PASSWORD=change_me
RABBITMQ_ADDR=127.0.0.1:5672

MINIO_ROOT_USER=devhub
MINIO_ROOT_PASSWORD=change_me
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_BUCKET=devhub-projects
MINIO_USE_SSL=false

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://devhub:change_me@127.0.0.1:5432/devhub?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations

# 至少 32 个随机字符；仅保存在本地 .env 或部署环境变量中。
AUTH_JWT_SECRET=replace_with_a_random_secret_at_least_32_chars

# 可选：离线 GeoLite2-City.mmdb 文件；代理地址必须明确配置才会信任 X-Forwarded-For。
IP_REGION_DB_PATH=
HTTP_TRUSTED_PROXIES=

# 本地开发连接 Docker Mailpit；生产环境改为真实 SMTP 并使用 TLS。
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=DevHub <no-reply@devhub.local>
SMTP_TLS_MODE=none
SMTP_USERNAME=
SMTP_PASSWORD=

# 可选：兼容 Chat Completions 的模型服务；三项全部填写后启用生成回答。
# 未配置时助手仍可检索已发布文章并返回原文摘录。
ASSISTANT_API_BASE_URL=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
