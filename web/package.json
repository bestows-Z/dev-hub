{
  "name": "devhub-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write src index.html vite.config.ts",
